# Get a free key at https://aistudio.google.com/apikey
# Without a key the app still runs: every agent falls back to its built-in rule engine.
GEMINI_API_KEY=

# Optional: override the Gemini model.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- v2: accounts (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OAuth buttons to show once each provider is enabled in Supabase (e.g. google,github,azure). Email sign-in always works.
NEXT_PUBLIC_OAUTH_PROVIDERS=
# server only: lets the Question Smith write the shared question bank. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# --- v2: question bank ---
# protects /api/bank/grow (one Question Smith step per call); any long random string
BANK_GROW_SECRET=
